<%- include("../template/cabecera", {tituloWeb: "Mesa de Estadísticas: " + evento.nombre}) %>

<style>
    #nav-categorias { max-height: 78vh; overflow-y: auto; }
    #nav-categorias .nav-link {
        text-align: left; font-size: .85rem; border-radius: 6px; margin-bottom: 4px;
        border: 1px solid #dee2e6; background: #f8f9fa; color: #333; padding: .55rem .75rem;
    }
    #nav-categorias .nav-link:hover { background: #e9ecef; }
    #nav-categorias .nav-link.active {
        background: var(--bs-primary, #0d6efd); color: #fff; border-color: var(--bs-primary, #0d6efd); font-weight: 700;
    }
    .voto-descartado { background: #eef0f2; color: #adb5bd; text-decoration: line-through; }
    .fila-lugar-1 td { background: #fff8e1; }
    .etapa-card .card-header { font-weight: 600; }
</style>

<div class="p-3 divGeneral">

    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-table me-2 text-primary"></i>Mesa de Estadísticas</h4>
            <small class="text-muted"><%= evento.nombre %> — auditoría de votación por categoría y etapa</small>
        </div>
        <% if (puedeGestionarCola) { %>
            <button type="button" id="btnEnviarColaGlobal" class="btn btn-warning fw-bold <%= colaPendienteCount ? '' : 'disabled' %>"
                    onclick="enviarColaGlobal()" data-evento-id="<%= evento.id %>">
                <i class="fas fa-paper-plane me-1"></i> ENVIAR COLA DE RESULTADOS
                <span class="badge bg-dark ms-1" id="badgeColaPendiente"><%= colaPendienteCount %></span>
            </button>
        <% } %>
    </div>

    <% if (!categorias.length) { %>
        <div class="alert alert-warning">Este evento no tiene categorías registradas.</div>
    <% } else { %>
    <div class="row">
        <div class="col-12 col-md-3 mb-3">
            <div class="nav flex-column nav-pills" id="nav-categorias" role="tablist" aria-orientation="vertical">
                <% categorias.forEach((cat, i) => { %>
                    <button class="nav-link <%= i === 0 ? 'active' : '' %>"
                            data-bs-toggle="pill" data-bs-target="#tab-cat-<%= cat.id %>"
                            type="button" role="tab">
                        <%= cat.nombre %>
                        <% if (!cat.tieneAtletas) { %><span class="badge bg-light text-muted border ms-1" style="font-size:.65rem;">sin atletas</span><% } %>
                    </button>
                <% }) %>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <div class="tab-content">
                <% categorias.forEach((cat, i) => { %>
                    <div class="tab-pane fade <%= i === 0 ? 'show active' : '' %>" id="tab-cat-<%= cat.id %>" role="tabpanel">
                        <h5 class="fw-bold mb-3"><%= cat.nombre %></h5>

                        <% if (!cat.fases.length) { %>
                            <div class="text-muted fst-italic py-5 text-center">
                                <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                                Sin atletas inscritos en esta categoría.
                            </div>
                        <% } %>

                        <% cat.fases.forEach(f => { %>
                            <%
                                const esFinal = f.fase === 'final_r1' || f.fase === 'final_r2';
                                const tablaId = 'tabla-' + cat.id + '-' + f.fase;
                            %>
                            <div class="card shadow-sm mb-4 etapa-card">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span><%= f.faseLabel %></span>
                                        <% if (f.conVotos) { %>
                                            <span class="badge bg-secondary" id="<%= tablaId %>-rondas">Recortes: 0</span>
                                            <button type="button" class="btn btn-sm btn-outline-dark" onclick="recortarExtremos('<%= tablaId %>')">
                                                <i class="fas fa-cut me-1"></i> Recortar extremos (1 alta / 1 baja)
                                            </button>
                                        <% } %>
                                    </div>
                                    <% if (f.conVotos && puedeGestionarCola) { %>
                                        <div class="d-flex gap-2" id="<%= tablaId %>-acciones">
                                            <% if (esFinal) { %>
                                                <% if (cat.enCola) { %>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                        <i class="fas fa-check me-1"></i> En cola
                                                    </button>
                                                <% } else { %>
                                                    <button type="button" class="btn btn-sm btn-warning"
                                                            data-cat-id="<%= cat.id %>"
                                                            data-evento-id="<%= evento.id %>"
                                                            data-cat-nombre="<%= cat.nombre %>"
                                                            data-fase="<%= f.fase %>"
                                                            data-tabla="<%= tablaId %>"
                                                            onclick="agregarColaFase(this)">
                                                        <i class="fas fa-inbox me-1"></i> Agregar a la cola
                                                    </button>
                                                <% } %>
                                            <% } %>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    data-cat-id="<%= cat.id %>"
                                                    data-cat-nombre="<%= cat.nombre %>"
                                                    data-fase="<%= f.fase %>"
                                                    data-tabla="<%= tablaId %>"
                                                    onclick="enviarColaFase(this)">
                                                <i class="fas fa-paper-plane me-1"></i>
                                                <%= esFinal ? 'Enviar resultados al MC' : 'Enviar clasificados a Backstage y MC' %>
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm mb-0 align-middle" id="<%= tablaId %>">
                                            <thead class="table-dark">
                                                <tr>
                                                    <% if (f.conVotos && !esFinal) { %><th style="width:70px;">Clasifica</th><% } %>
                                                    <th style="width:70px;">Lugar</th>
                                                    <th>Atleta</th>
                                                    <th style="width:80px;">Dorsal</th>
                                                    <% jueces.forEach(j => { %><th class="text-center"><%= j.nombre %></th><% }) %>
                                                    <th class="text-center" style="width:70px;">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% if (!f.conVotos) { %>
                                                    <% f.filas.forEach(fila => { %>
                                                        <tr>
                                                            <td class="fw-bold">—</td>
                                                            <td><%= fila.atleta %></td>
                                                            <td><span class="badge bg-light text-dark border"><%= fila.dorsal %></span></td>
                                                            <% jueces.forEach(() => { %><td class="text-center">—</td><% }) %>
                                                            <td class="text-center fw-bold">—</td>
                                                        </tr>
                                                    <% }) %>
                                                <% } %>
                                                <%# Bloques con votos: el <tbody> lo pinta el JS de abajo (recorte manual + desempate) %>
                                            </tbody>
                                        </table>
                                    </div>
                                    <% if (f.conVotos) { %>
                                        <div id="<%= tablaId %>-empates"></div>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
    <% } %>

</div>

<script>
const _JUECES = <%- JSON.stringify(jueces) %>;
const _BLOQUES = <%- JSON.stringify(
    categorias.flatMap(cat => cat.fases.filter(f => f.conVotos).map(f => ({
        tablaId: 'tabla-' + cat.id + '-' + f.fase,
        catId: cat.id,
        catNombre: cat.nombre,
        fase: f.fase,
        esFinal: f.fase === 'final_r1' || f.fase === 'final_r2',
        limiteClasificacion: f.fase === 'eliminatoria' ? 15 : 6,
        atletas: f.filas
    })))
) %>;

function escHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

// ══════════════════════════════════════════════════════════════════════════
// ESTADO Y CÁLCULO — el recorte de extremos ya NO es automático: cada click
// de "Recortar extremos" quita UN voto más alto y UN voto más bajo (por
// atleta) de la ronda actual. El estadístico decide cuántas veces lo
// acciona según la cantidad de jueces del panel.
// ══════════════════════════════════════════════════════════════════════════
const _estadoBloques = {};

function iniciarBloque(b) {
    _estadoBloques[b.tablaId] = {
        rondas: 0,
        resueltos: {}, // atleta_id -> orden manual asignado al resolver un empate
        recortesEmpate: {},
        atletas: b.atletas.map(a => ({
            atleta_id: a.atleta_id,
            nombre: a.atleta,
            dorsal: a.dorsal,
            votos: a.votos, // originales, nunca se mutan
            eliminado: a.votos.map(() => false)
        }))
    };
    renderBloque(b.tablaId);
}

function votosActivos(atleta) {
    return atleta.votos
        .map((v, i) => ({ v, i }))
        .filter(x => x.v !== null && x.v !== undefined && !atleta.eliminado[x.i]);
}

function calcularTotal(atleta) {
    const activos = votosActivos(atleta);
    if (!activos.length) return null;
    return activos.reduce((s, x) => s + x.v, 0);
}

// Quita, de CADA atleta del bloque, una instancia del voto más bajo y una del
// más alto entre sus votos aún activos (no vuelve a tocar los ya recortados).
// Dejar al menos 1 voto activo por atleta.
function recortarExtremos(tablaId) {
    const est = _estadoBloques[tablaId];
    est.atletas.forEach(atleta => {
        const activos = votosActivos(atleta);
        if (activos.length <= 1) return;
        const valores = activos.map(x => x.v);
        const minV = Math.min(...valores), maxV = Math.max(...valores);
        const idxMin = activos.find(x => x.v === minV).i;
        const idxMax = [...activos].reverse().find(x => x.v === maxV).i;
        atleta.eliminado[idxMin] = true;
        if (idxMax !== idxMin) atleta.eliminado[idxMax] = true;
    });
    est.rondas++;
    renderBloque(tablaId);
}

function calcularFilasOrdenadas(tablaId) {
    const est = _estadoBloques[tablaId];
    const filas = est.atletas.map(a => ({ a, total: calcularTotal(a) }));
    filas.sort((x, y) => {
        if (x.total === null) return 1;
        if (y.total === null) return -1;
        if (x.total !== y.total) return x.total - y.total;
        const rx = est.resueltos[x.a.atleta_id] ?? 0;
        const ry = est.resueltos[y.a.atleta_id] ?? 0;
        return rx - ry;
    });
    filas.forEach((f, idx) => {
        if (f.total === null) { f.lugar = null; return; }
        const anterior = filas[idx - 1];
        const mismoTotal = anterior && anterior.total === f.total;
        const yaResueltosEntreSi = mismoTotal && est.resueltos[anterior.a.atleta_id] !== undefined && est.resueltos[f.a.atleta_id] !== undefined;
        if (mismoTotal && !yaResueltosEntreSi) f.lugar = anterior.lugar;
        else f.lugar = idx + 1;
    });
    return filas;
}

function gruposEmpate(filas) {
    const porLugar = {};
    filas.forEach(f => {
        if (f.lugar === null) return;
        (porLugar[f.lugar] = porLugar[f.lugar] || []).push(f);
    });
    return Object.values(porLugar).filter(g => g.length > 1);
}

// ══════════════════════════════════════════════════════════════════════════
// DESEMPATE — método de Relative Placement: compara, valor por valor (1°,
// 2°, 3°...), cuántos jueces le dieron esa posición a cada atleta empatado.
// El primer valor donde alguien tenga MÁS votos que el resto lo separa, SIN
// eliminar ningún voto. Si dos+ siguen empatados en todos los valores,
// quedan pendientes para el recorte exclusivo de ese grupo.
// ══════════════════════════════════════════════════════════════════════════
function resolverRelativePlacement(atletas) {
    function recursivo(grupo, valores, detalle) {
        if (grupo.length <= 1) return { orden: grupo.map(a => a.atleta_id), resuelto: true, detalle };
        if (!valores.length) return { orden: grupo.map(a => a.atleta_id), resuelto: false, detalle };

        const v = valores[0];
        const resto = valores.slice(1);
        const counts = grupo.map(a => a.votos.filter(x => x === v).length);
        const maxC = Math.max(...counts);
        detalle.push({ valor: v, conteos: grupo.map((a, i) => ({ nombre: a.nombre, count: counts[i] })) });

        if (counts.every(c => c === maxC)) return recursivo(grupo, resto, detalle);

        const lideres = grupo.filter((a, i) => counts[i] === maxC);
        const rezagados = grupo.filter((a, i) => counts[i] !== maxC);
        const subLideres = recursivo(lideres, resto, detalle);
        const subRezagados = recursivo(rezagados, resto, detalle);
        return {
            orden: [...subLideres.orden, ...subRezagados.orden],
            resuelto: subLideres.resuelto && subRezagados.resuelto,
            detalle
        };
    }
    const valoresPosibles = [...new Set(atletas.flatMap(a => a.votos))].sort((x, y) => x - y);
    return recursivo(atletas, valoresPosibles, []);
}

function recortarEmpate(tablaId, key) {
    const est = _estadoBloques[tablaId];
    const grupo = est.recortesEmpate[key];
    grupo.atletas.forEach(atleta => {
        const activos = atleta.votos.map((v, i) => ({ v, i })).filter(x => !atleta.eliminado[x.i]);
        if (activos.length <= 1) return;
        const valores = activos.map(x => x.v);
        const minV = Math.min(...valores), maxV = Math.max(...valores);
        const idxMin = activos.find(x => x.v === minV).i;
        const idxMax = [...activos].reverse().find(x => x.v === maxV).i;
        atleta.eliminado[idxMin] = true;
        if (idxMax !== idxMin) atleta.eliminado[idxMax] = true;
    });
    grupo.rondas++;
    renderBloque(tablaId);
}

// Fija el orden resuelto (aplicado desde el panel de empate) en el listado
// general — no toca los votos del listado general, solo el orden relativo
// entre estos atletas para cuando compartan el mismo total.
function aplicarDesempate(tablaId, ordenIds) {
    const est = _estadoBloques[tablaId];
    ordenIds.forEach((atleta_id, i) => { est.resueltos[atleta_id] = i; });
    renderBloque(tablaId);
}

function crearPanelEmpate(tablaId, grupo, indice) {
    const est = _estadoBloques[tablaId];
    const nombresGrupo = grupo.map(f => f.a.nombre).join(' vs. ');

    const atletasRP = grupo.map(f => ({ atleta_id: f.a.atleta_id, nombre: f.a.nombre, votos: f.a.votos.filter(v => v !== null && v !== undefined) }));
    const rp = resolverRelativePlacement(atletasRP);
    const valoresPosibles = [...new Set(atletasRP.flatMap(a => a.votos))].sort((x, y) => x - y);

    let html = `<div class="card border-warning mb-3">
        <div class="card-header bg-warning bg-opacity-25 fw-bold">
            <i class="fas fa-exclamation-triangle text-warning me-1"></i> Empate en el lugar ${grupo[0].lugar}° — ${escHtml(nombresGrupo)}
        </div>
        <div class="card-body">
            <p class="small text-muted mb-2">Método de comparación (Relative Placement) — votos ORIGINALES de cada juez, sin ningún recorte:</p>
            <div class="table-responsive mb-2">
                <table class="table table-sm table-bordered mb-0 text-center">
                    <thead class="table-light"><tr><th>Posición dada por el juez</th>${grupo.map(f => `<th>${escHtml(f.a.nombre)}</th>`).join('')}</tr></thead>
                    <tbody>
                        ${valoresPosibles.map(v => `<tr><td class="fw-bold">${v}°</td>${atletasRP.map(a => `<td>${a.votos.filter(x => x === v).length}</td>`).join('')}</tr>`).join('')}
                    </tbody>
                </table>
            </div>`;

    if (rp.resuelto) {
        const nombresOrden = rp.orden.map(id => grupo.find(f => f.a.atleta_id === id).a.nombre);
        html += `<div class="alert alert-success py-2 mb-2">
            <i class="fas fa-check-circle me-1"></i> Se puede desempatar solo mirando los votos (sin eliminar ninguno) — un atleta tiene más votos bajos que el otro. Orden: <strong>${nombresOrden.map(escHtml).join(' → ')}</strong>.
        </div>
        <button type="button" class="btn btn-sm btn-success" onclick='aplicarDesempate(${JSON.stringify(tablaId)}, ${JSON.stringify(rp.orden)})'>
            <i class="fas fa-check me-1"></i> Aplicar este orden al listado general
        </button>`;
    } else {
        const key = 'empate_' + grupo.map(f => f.a.atleta_id).sort().join('_');
        if (!est.recortesEmpate[key]) {
            est.recortesEmpate[key] = {
                rondas: 0,
                atletas: grupo.map(f => ({ atleta_id: f.a.atleta_id, nombre: f.a.nombre, votos: [...f.a.votos], eliminado: f.a.votos.map(() => false) }))
            };
        }
        const estGrupo = est.recortesEmpate[key];
        const totalesGrupo = estGrupo.atletas.map(a => {
            const activos = a.votos.map((v, i) => ({ v, i })).filter(x => x.v !== null && x.v !== undefined && !a.eliminado[x.i]);
            return { atleta_id: a.atleta_id, nombre: a.nombre, total: activos.length ? activos.reduce((s, x) => s + x.v, 0) : null };
        });
        const distintos = new Set(totalesGrupo.map(t => t.total)).size > 1;

        html += `<div class="alert alert-warning py-2 mb-2">
            <i class="fas fa-info-circle me-1"></i> Los votos originales no alcanzan para desempatar — misma cantidad de votos en cada posición. Use el recorte exclusivo de este grupo (no afecta el listado general ni sus propios votos originales).
        </div>
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-secondary">Recortes de este grupo: ${estGrupo.rondas}</span>
            <button type="button" class="btn btn-sm btn-outline-dark" onclick='recortarEmpate(${JSON.stringify(tablaId)}, ${JSON.stringify(key)})'>
                <i class="fas fa-cut me-1"></i> Recortar extremos (solo este grupo)
            </button>
        </div>
        <div class="table-responsive mb-2">
            <table class="table table-sm table-bordered mb-0 text-center">
                <thead class="table-light"><tr><th>Atleta</th>${_JUECES.map(j => `<th>${escHtml(j.nombre)}</th>`).join('')}<th>Total</th></tr></thead>
                <tbody>
                    ${estGrupo.atletas.map(a => `<tr><td>${escHtml(a.nombre)}</td>${a.votos.map((v, i) => `<td class="${a.eliminado[i] ? 'voto-descartado' : ''}">${(v === null || v === undefined) ? '—' : v}</td>`).join('')}<td class="fw-bold">${totalesGrupo.find(t => t.atleta_id === a.atleta_id).total ?? '—'}</td></tr>`).join('')}
                </tbody>
            </table>
        </div>`;

        if (distintos) {
            const ordenActual = [...totalesGrupo].sort((a, b) => (a.total ?? 1e9) - (b.total ?? 1e9));
            html += `<div class="alert alert-success py-2 mb-2"><i class="fas fa-check-circle me-1"></i> El recorte separó los totales — orden: <strong>${ordenActual.map(o => escHtml(o.nombre)).join(' → ')}</strong>.</div>
            <button type="button" class="btn btn-sm btn-success" onclick='aplicarDesempate(${JSON.stringify(tablaId)}, ${JSON.stringify(ordenActual.map(o => o.atleta_id))})'>
                <i class="fas fa-check me-1"></i> Aplicar este orden al listado general
            </button>`;
        }
    }

    html += `</div></div>`;
    const div = document.createElement('div');
    div.innerHTML = html;
    return div.firstElementChild;
}

// ══════════════════════════════════════════════════════════════════════════
// RENDER
// ══════════════════════════════════════════════════════════════════════════
function renderBloque(tablaId) {
    const b = _BLOQUES.find(x => x.tablaId === tablaId);
    const est = _estadoBloques[tablaId];
    const filas = calcularFilasOrdenadas(tablaId);
    const grupos = gruposEmpate(filas);
    const enEmpate = new Set(grupos.flatMap(g => g.map(f => f.a.atleta_id)));

    const badgeRondas = document.getElementById(tablaId + '-rondas');
    if (badgeRondas) badgeRondas.textContent = 'Recortes: ' + est.rondas;

    const tabla = document.getElementById(tablaId);
    const tbody = tabla.querySelector('tbody');
    tbody.innerHTML = filas.map(f => {
        const atleta = f.a;
        const empatado = enEmpate.has(atleta.atleta_id);
        const celdas = _JUECES.map((j, i) => {
            const v = atleta.votos[i];
            const eliminado = atleta.eliminado[i];
            return `<td class="text-center ${eliminado ? 'voto-descartado' : ''}" ${eliminado ? 'title="Voto recortado manualmente"' : ''}>${(v === null || v === undefined) ? '—' : v}</td>`;
        }).join('');
        const chk = !b.esFinal
            ? `<td><input type="checkbox" class="form-check-input chk-clasif" value="${atleta.atleta_id}" ${(f.lugar && f.lugar <= b.limiteClasificacion) ? 'checked' : ''}></td>`
            : '';
        return `<tr class="${f.lugar === 1 ? 'fila-lugar-1' : ''}" data-atleta="${atleta.atleta_id}" data-lugar="${f.lugar ?? ''}">
            ${chk}
            <td class="fw-bold">${f.lugar ? f.lugar + '°' : '—'} ${empatado ? '<span class="badge bg-warning text-dark ms-1"><i class="fas fa-exclamation-triangle"></i> Empate</span>' : ''}</td>
            <td>${escHtml(atleta.nombre)}</td>
            <td><span class="badge bg-light text-dark border">${atleta.dorsal}</span></td>
            ${celdas}
            <td class="text-center fw-bold">${f.total === null ? '—' : f.total}</td>
        </tr>`;
    }).join('');

    const contEmpates = document.getElementById(tablaId + '-empates');
    contEmpates.innerHTML = '';
    grupos.forEach((g, gi) => contEmpates.appendChild(crearPanelEmpate(tablaId, g, gi)));

    const acciones = document.getElementById(tablaId + '-acciones');
    if (acciones) {
        acciones.querySelectorAll('button:not(.btn-outline-secondary)').forEach(btn => {
            btn.disabled = grupos.length > 0;
            btn.title = grupos.length > 0 ? 'Resuelva el/los empate(s) antes de enviar' : '';
        });
    }
}

_BLOQUES.forEach(iniciarBloque);
</script>

<script>
// Envía la cola de esta etapa: clasificados (dorsal, sin posición) para
// eliminatoria/semifinal → Backstage + MC, o resultados (con posición) de
// una final → solo MC. El servidor decide el destino según la fase.
async function enviarColaFase(btn) {
    const { catId, catNombre, fase, tabla } = btn.dataset;
    const esFinal = fase === 'final_r1' || fase === 'final_r2';
    const tablaEl = document.getElementById(tabla);

    const atletaIds = [];
    const resultados = [];

    if (esFinal) {
        tablaEl.querySelectorAll('tbody tr[data-atleta]').forEach(tr => {
            atletaIds.push(tr.dataset.atleta);
            if (tr.dataset.lugar) resultados.push({ atleta_id: tr.dataset.atleta, posicion: parseInt(tr.dataset.lugar, 10) });
        });
    } else {
        tablaEl.querySelectorAll('.chk-clasif:checked').forEach(chk => atletaIds.push(chk.value));
    }

    if (!atletaIds.length) { alert('No hay atletas para enviar.'); return; }

    const destino = esFinal ? 'al MC' : 'a Backstage y MC';
    if (!confirm(`¿Enviar ${atletaIds.length} atleta(s) ${destino}?`)) return;

    btn.disabled = true;
    try {
        const res = await fetch('/estadisticas/enviar-clasificados-mc', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                eventoCatId: catId,
                categoriaNombre: catNombre,
                fase,
                atletasIdsClasificados: atletaIds,
                resultados: esFinal ? resultados : undefined
            })
        });
        const data = await res.json();
        alert(data.ok ? `Enviado ${destino} correctamente (${atletaIds.length} atletas).` : 'Error: ' + data.mensaje);
    } catch (e) {
        alert('Error de red: ' + e.message);
    } finally {
        btn.disabled = false;
    }
}

// Agrega el resultado de un bloque final a la cola pendiente del evento —
// queda invisible para el MC hasta que se presione "ENVIAR COLA DE RESULTADOS".
async function agregarColaFase(btn) {
    const { catId, eventoId, catNombre, fase, tabla } = btn.dataset;
    const tablaEl = document.getElementById(tabla);

    const atletaIds = [];
    const resultados = [];
    tablaEl.querySelectorAll('tbody tr[data-atleta]').forEach(tr => {
        atletaIds.push(tr.dataset.atleta);
        if (tr.dataset.lugar) resultados.push({ atleta_id: tr.dataset.atleta, posicion: parseInt(tr.dataset.lugar, 10) });
    });
    if (!atletaIds.length) { alert('No hay atletas para agregar a la cola.'); return; }

    btn.disabled = true;
    try {
        const res = await fetch('/estadisticas/agregar-cola-resultados', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                eventoId, eventoCatId: catId, categoriaNombre: catNombre, fase,
                atletasIdsClasificados: atletaIds, resultados
            })
        });
        const data = await res.json();
        if (!data.ok) { alert('Error: ' + data.mensaje); btn.disabled = false; return; }

        btn.outerHTML = '<button type="button" class="btn btn-sm btn-outline-secondary" disabled><i class="fas fa-check me-1"></i> En cola</button>';
        const badge = document.getElementById('badgeColaPendiente');
        if (badge) badge.textContent = data.pendientes;
        const btnGlobal = document.getElementById('btnEnviarColaGlobal');
        if (btnGlobal) btnGlobal.classList.remove('disabled');
    } catch (e) {
        alert('Error de red: ' + e.message);
        btn.disabled = false;
    }
}

// Vacía toda la cola pendiente del evento hacia el Monitor MC de una sola vez
// (el MC la recorre luego una por una con el botón "Siguiente resultado").
async function enviarColaGlobal() {
    const btn = document.getElementById('btnEnviarColaGlobal');
    const { eventoId } = btn.dataset;
    const pendientes = document.getElementById('badgeColaPendiente').textContent;
    if (pendientes === '0') return;
    if (!confirm(`¿Enviar ${pendientes} resultado(s) pendiente(s) al Monitor MC?`)) return;

    btn.classList.add('disabled');
    try {
        const res = await fetch('/estadisticas/enviar-cola-resultados', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ eventoId })
        });
        const data = await res.json();
        if (data.ok) {
            alert(`Cola enviada al Monitor MC (${data.enviados} resultado(s)).`);
            location.reload();
        } else {
            alert('Error: ' + data.mensaje);
            btn.classList.remove('disabled');
        }
    } catch (e) {
        alert('Error de red: ' + e.message);
        btn.classList.remove('disabled');
    }
}
</script>

