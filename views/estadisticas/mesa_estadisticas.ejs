<%- include("../template/cabecera", {tituloWeb: "Mesa de Estadísticas: " + evento.nombre}) %>

<style>
    #nav-categorias { max-height: 78vh; overflow-y: auto; }
    #nav-categorias .nav-link {
        text-align: left; font-size: .85rem; border-radius: 6px; margin-bottom: 4px;
        border: 1px solid #dee2e6; background: #f8f9fa; color: #333; padding: .55rem .75rem;
    }
    #nav-categorias .nav-link:hover { background: #e9ecef; }
    #nav-categorias .nav-link.active {
        background: var(--bs-primary, #0d6efd); color: #fff; border-color: var(--bs-primary, #0d6efd); font-weight: 700;
    }
    .voto-descartado { background: #eef0f2; color: #adb5bd; text-decoration: line-through; }
    .fila-lugar-1 td { background: #fff8e1; }
    .etapa-card .card-header { font-weight: 600; }
</style>

<div class="p-3 divGeneral">

    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div>
            <h4 class="mb-0"><i class="fas fa-table me-2 text-primary"></i>Mesa de Estadísticas</h4>
            <small class="text-muted"><%= evento.nombre %> — auditoría de votación por categoría y etapa</small>
        </div>
        <% if (puedeGestionarCola) { %>
            <button type="button" id="btnEnviarColaGlobal" class="btn btn-warning fw-bold <%= colaPendienteCount ? '' : 'disabled' %>"
                    onclick="enviarColaGlobal()" data-evento-id="<%= evento.id %>">
                <i class="fas fa-paper-plane me-1"></i> ENVIAR COLA DE RESULTADOS
                <span class="badge bg-dark ms-1" id="badgeColaPendiente"><%= colaPendienteCount %></span>
            </button>
        <% } %>
    </div>

    <% if (!categorias.length) { %>
        <div class="alert alert-warning">Este evento no tiene categorías registradas.</div>
    <% } else { %>
    <div class="row">
        <div class="col-12 col-md-3 mb-3">
            <div class="nav flex-column nav-pills" id="nav-categorias" role="tablist" aria-orientation="vertical">
                <% categorias.forEach((cat, i) => { %>
                    <button class="nav-link <%= i === 0 ? 'active' : '' %>"
                            data-bs-toggle="pill" data-bs-target="#tab-cat-<%= cat.id %>"
                            type="button" role="tab">
                        <%= cat.nombre %>
                        <% if (!cat.tieneAtletas) { %><span class="badge bg-light text-muted border ms-1" style="font-size:.65rem;">sin atletas</span><% } %>
                    </button>
                <% }) %>
            </div>
        </div>

        <div class="col-12 col-md-9">
            <div class="tab-content">
                <% categorias.forEach((cat, i) => { %>
                    <div class="tab-pane fade <%= i === 0 ? 'show active' : '' %>" id="tab-cat-<%= cat.id %>" role="tabpanel">
                        <h5 class="fw-bold mb-3"><%= cat.nombre %></h5>

                        <% if (!cat.fases.length) { %>
                            <div class="text-muted fst-italic py-5 text-center">
                                <i class="fas fa-inbox fa-2x mb-2 d-block opacity-25"></i>
                                Sin atletas inscritos en esta categoría.
                            </div>
                        <% } %>

                        <% cat.fases.forEach(f => { %>
                            <%
                                const esFinal = f.fase === 'final_r1' || f.fase === 'final_r2';
                                const limiteClasificacion = f.fase === 'eliminatoria' ? 15 : 6;
                                const tablaId = 'tabla-' + cat.id + '-' + f.fase;
                            %>
                            <div class="card shadow-sm mb-4 etapa-card">
                                <div class="card-header bg-light d-flex justify-content-between align-items-center flex-wrap gap-2">
                                    <span><%= f.faseLabel %></span>
                                    <% if (f.conVotos && puedeGestionarCola) { %>
                                        <div class="d-flex gap-2">
                                            <% if (esFinal) { %>
                                                <% if (cat.enCola) { %>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>
                                                        <i class="fas fa-check me-1"></i> En cola
                                                    </button>
                                                <% } else { %>
                                                    <button type="button" class="btn btn-sm btn-warning"
                                                            data-cat-id="<%= cat.id %>"
                                                            data-evento-id="<%= evento.id %>"
                                                            data-cat-nombre="<%= cat.nombre %>"
                                                            data-fase="<%= f.fase %>"
                                                            data-tabla="<%= tablaId %>"
                                                            onclick="agregarColaFase(this)">
                                                        <i class="fas fa-inbox me-1"></i> Agregar a la cola
                                                    </button>
                                                <% } %>
                                            <% } %>
                                            <button type="button" class="btn btn-sm btn-success"
                                                    data-cat-id="<%= cat.id %>"
                                                    data-cat-nombre="<%= cat.nombre %>"
                                                    data-fase="<%= f.fase %>"
                                                    data-tabla="<%= tablaId %>"
                                                    onclick="enviarColaFase(this)">
                                                <i class="fas fa-paper-plane me-1"></i>
                                                <%= esFinal ? 'Enviar resultados al MC' : 'Enviar clasificados a Backstage y MC' %>
                                            </button>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="card-body p-0">
                                    <div class="table-responsive">
                                        <table class="table table-bordered table-sm mb-0 align-middle" id="<%= tablaId %>">
                                            <thead class="table-dark">
                                                <tr>
                                                    <% if (f.conVotos && !esFinal) { %><th style="width:70px;">Clasifica</th><% } %>
                                                    <th style="width:70px;">Lugar</th>
                                                    <th>Atleta</th>
                                                    <th style="width:80px;">Dorsal</th>
                                                    <% jueces.forEach(j => { %><th class="text-center"><%= j.nombre %></th><% }) %>
                                                    <th class="text-center" style="width:70px;">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% f.filas.forEach(fila => { %>
                                                    <tr class="<%= fila.lugarSugerido === 1 ? 'fila-lugar-1' : '' %>"
                                                        data-atleta="<%= fila.atleta_id %>"
                                                        data-lugar="<%= fila.lugarSugerido || '' %>">
                                                        <% if (f.conVotos && !esFinal) { %>
                                                            <td>
                                                                <input type="checkbox" class="form-check-input chk-clasif" value="<%= fila.atleta_id %>"
                                                                       <%= (fila.lugarSugerido && fila.lugarSugerido <= limiteClasificacion) ? 'checked' : '' %>>
                                                            </td>
                                                        <% } %>
                                                        <td class="fw-bold">
                                                            <% if (fila.lugarSugerido) { %><%= fila.lugarSugerido %>°<% } else { %>—<% } %>
                                                            <% if (fila.empateDetectado) { %>
                                                                <i class="fas fa-equals text-warning" title="Empate en puntos — desempate por Relative Placement"></i>
                                                            <% } %>
                                                        </td>
                                                        <td><%= fila.atleta %></td>
                                                        <td><span class="badge bg-light text-dark border"><%= fila.dorsal %></span></td>
                                                        <% fila.votosJuez.forEach(v => { %>
                                                            <td class="text-center <%= v.descartado ? 'voto-descartado' : '' %>"
                                                                <% if (v.descartado) { %>title="Voto descartado (extremo, regla de 5+ jueces)"<% } %>>
                                                                <%= (v.valor !== undefined && v.valor !== null) ? v.valor : '—' %>
                                                            </td>
                                                        <% }) %>
                                                        <td class="text-center fw-bold"><%= (fila.total !== null && fila.total !== undefined) ? fila.total : '—' %></td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
    <% } %>

</div>

<script>
// Envía la cola de esta etapa: clasificados (dorsal, sin posición) para
// eliminatoria/semifinal → Backstage + MC, o resultados (con posición) de
// una final → solo MC. El servidor decide el destino según la fase.
async function enviarColaFase(btn) {
    const { catId, catNombre, fase, tabla } = btn.dataset;
    const esFinal = fase === 'final_r1' || fase === 'final_r2';
    const tablaEl = document.getElementById(tabla);

    const atletaIds = [];
    const resultados = [];

    if (esFinal) {
        tablaEl.querySelectorAll('tbody tr[data-atleta]').forEach(tr => {
            atletaIds.push(tr.dataset.atleta);
            if (tr.dataset.lugar) resultados.push({ atleta_id: tr.dataset.atleta, posicion: parseInt(tr.dataset.lugar, 10) });
        });
    } else {
        tablaEl.querySelectorAll('.chk-clasif:checked').forEach(chk => atletaIds.push(chk.value));
    }

    if (!atletaIds.length) { alert('No hay atletas para enviar.'); return; }

    const destino = esFinal ? 'al MC' : 'a Backstage y MC';
    if (!confirm(`¿Enviar ${atletaIds.length} atleta(s) ${destino}?`)) return;

    btn.disabled = true;
    try {
        const res = await fetch('/estadisticas/enviar-clasificados-mc', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                eventoCatId: catId,
                categoriaNombre: catNombre,
                fase,
                atletasIdsClasificados: atletaIds,
                resultados: esFinal ? resultados : undefined
            })
        });
        const data = await res.json();
        alert(data.ok ? `Enviado ${destino} correctamente (${atletaIds.length} atletas).` : 'Error: ' + data.mensaje);
    } catch (e) {
        alert('Error de red: ' + e.message);
    } finally {
        btn.disabled = false;
    }
}

// Agrega el resultado de un bloque final a la cola pendiente del evento —
// queda invisible para el MC hasta que se presione "ENVIAR COLA DE RESULTADOS".
async function agregarColaFase(btn) {
    const { catId, eventoId, catNombre, fase, tabla } = btn.dataset;
    const tablaEl = document.getElementById(tabla);

    const atletaIds = [];
    const resultados = [];
    tablaEl.querySelectorAll('tbody tr[data-atleta]').forEach(tr => {
        atletaIds.push(tr.dataset.atleta);
        if (tr.dataset.lugar) resultados.push({ atleta_id: tr.dataset.atleta, posicion: parseInt(tr.dataset.lugar, 10) });
    });
    if (!atletaIds.length) { alert('No hay atletas para agregar a la cola.'); return; }

    btn.disabled = true;
    try {
        const res = await fetch('/estadisticas/agregar-cola-resultados', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                eventoId, eventoCatId: catId, categoriaNombre: catNombre, fase,
                atletasIdsClasificados: atletaIds, resultados
            })
        });
        const data = await res.json();
        if (!data.ok) { alert('Error: ' + data.mensaje); btn.disabled = false; return; }

        btn.outerHTML = '<button type="button" class="btn btn-sm btn-outline-secondary" disabled><i class="fas fa-check me-1"></i> En cola</button>';
        const badge = document.getElementById('badgeColaPendiente');
        if (badge) badge.textContent = data.pendientes;
        const btnGlobal = document.getElementById('btnEnviarColaGlobal');
        if (btnGlobal) btnGlobal.classList.remove('disabled');
    } catch (e) {
        alert('Error de red: ' + e.message);
        btn.disabled = false;
    }
}

// Vacía toda la cola pendiente del evento hacia el Monitor MC de una sola vez
// (el MC la recorre luego una por una con el botón "Siguiente resultado").
async function enviarColaGlobal() {
    const btn = document.getElementById('btnEnviarColaGlobal');
    const { eventoId } = btn.dataset;
    const pendientes = document.getElementById('badgeColaPendiente').textContent;
    if (pendientes === '0') return;
    if (!confirm(`¿Enviar ${pendientes} resultado(s) pendiente(s) al Monitor MC?`)) return;

    btn.classList.add('disabled');
    try {
        const res = await fetch('/estadisticas/enviar-cola-resultados', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ eventoId })
        });
        const data = await res.json();
        if (data.ok) {
            alert(`Cola enviada al Monitor MC (${data.enviados} resultado(s)).`);
            location.reload();
        } else {
            alert('Error: ' + data.mensaje);
            btn.classList.remove('disabled');
        }
    } catch (e) {
        alert('Error de red: ' + e.message);
        btn.classList.remove('disabled');
    }
}
</script>

<%- include("../template/footer") %>
