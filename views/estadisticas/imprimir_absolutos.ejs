<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resultados Oficiales de Absolutos — <%= evento.nombre %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; font-size: 10pt; color: #111; background: #fff; }

        .controles {
            background: #1a1a2e; color: #fff; padding: 12px 20px;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        }
        .controles h5 { flex: 1; margin: 0; font-size: 13pt; }
        .controles button { padding: 7px 18px; border: none; border-radius: 5px; font-size: 10pt; cursor: pointer; font-weight: bold; }
        .btn-imprimir { background: #28a745; color: #fff; }
        .btn-cerrar   { background: #6c757d; color: #fff; }
        @media print { .controles { display: none !important; } }

        .documento { max-width: 900px; margin: 0 auto; padding: 14px 18px; }

        .cabecera { display: flex; align-items: center; border-bottom: 3px solid #c00; padding-bottom: 10px; margin-bottom: 10px; }
        .cabecera img { width: 72px; height: auto; margin-right: 14px; }
        .cabecera-texto h2 { font-size: 14pt; color: #c00; font-weight: bold; text-transform: uppercase; }
        .cabecera-texto h3 { font-size: 11pt; margin: 2px 0; }
        .cabecera-texto p  { font-size: 9pt; color: #555; }

        .titulo-listado {
            text-align: center; margin: 10px 0 14px;
            border: 2px solid #111; padding: 8px 12px; background: #111; color: #fff;
        }
        .titulo-listado h4 { font-size: 14pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }

        .grupo-bloque { margin-bottom: 18px; page-break-inside: avoid; }
        .grupo-header {
            background: #c00; color: #fff; padding: 5px 10px; font-weight: bold; font-size: 10.5pt;
            display: flex; justify-content: space-between;
        }
        .tabla-campeones { width: 100%; border-collapse: collapse; font-size: 9.5pt; }
        .tabla-campeones thead tr { background: #333; color: #fff; }
        .tabla-campeones th { padding: 4px 8px; text-align: left; font-weight: bold; }
        .tabla-campeones td { padding: 4px 8px; border-bottom: 1px solid #ddd; }
        .tabla-campeones tr.es-absoluto { background: #fff3cd; font-weight: bold; }
        .badge-absoluto { background: #c9a227; color: #111; padding: 2px 6px; border-radius: 3px; font-size: 8pt; font-weight: bold; }

        .pie { text-align: center; font-size: 8pt; color: #888; margin-top: 18px; border-top: 1px solid #ddd; padding-top: 6px; }
    </style>
</head>
<body>

<div class="controles">
    <h5>🏆 Resultados Oficiales de Absolutos — <%= evento.nombre %></h5>
    <button class="btn-imprimir" onclick="window.print()">🖨️ Imprimir</button>
    <button class="btn-cerrar" onclick="window.close()">✕ Cerrar</button>
</div>

<div class="documento">
    <div class="cabecera">
        <img src="/img/fdff3.jpg" alt="FDFF">
        <div class="cabecera-texto">
            <h2>Federación Dominicana de Fisiculturismo y Fitness</h2>
            <h3><%= evento.nombre %></h3>
            <p>
                <%= evento.lugar || '' %>
                <% if (evento.fecha_inicio) { %> &nbsp;|&nbsp; <%= new Date(evento.fecha_inicio).toLocaleDateString('es-DO', {year:'numeric',month:'long',day:'numeric'}) %> <% } %>
            </p>
        </div>
    </div>

    <div class="titulo-listado">
        <h4>Resultados Oficiales — Duelo de Campeones (Absolutos)</h4>
    </div>

    <% if (absolutos && absolutos.length > 0) { %>
        <% absolutos.forEach(grupo => { %>
            <div class="grupo-bloque">
                <div class="grupo-header">
                    <span><%= grupo.disciplina.toUpperCase() %> — MODALIDAD <%= grupo.modalidad.toUpperCase() %></span>
                    <span><%= grupo.campeones.length %> división<%= grupo.campeones.length !== 1 ? 'es' : '' %></span>
                </div>
                <table class="tabla-campeones">
                    <thead>
                        <tr><th>No.</th><th>Atleta</th><th>Categoría</th><th>División</th><th>Resultado</th></tr>
                    </thead>
                    <tbody>
                        <% grupo.campeones.forEach(c => { %>
                            <tr class="<%= c.esGanadorAbsoluto ? 'es-absoluto' : '' %>">
                                <td><%= c.dorsal || '—' %></td>
                                <td><%= c.nombre %></td>
                                <td><%= c.categoria %></td>
                                <td><%= c.division %></td>
                                <td>
                                    <% if (c.esGanadorAbsoluto) { %>
                                        <span class="badge-absoluto">CAMPEÓN ABSOLUTO</span>
                                    <% } else { %>
                                        Campeón de división
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% }) %>
    <% } else { %>
        <div style="text-align:center; padding: 40px; color:#888;">
            No hay grupos de absolutos disponibles para este evento (se requieren 2+ divisiones campeonas en la misma disciplina y modalidad).
        </div>
    <% } %>

    <div class="pie">
        Federación Dominicana de Fisiculturismo y Fitness (FDFF) — Documento oficial &nbsp;|&nbsp;
        Generado el <%= new Date().toLocaleDateString('es-DO', {year:'numeric',month:'long',day:'numeric'}) %>
    </div>
</div>

</body>
</html>
