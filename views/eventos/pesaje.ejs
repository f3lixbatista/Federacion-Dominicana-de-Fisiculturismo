<%- include("../template/cabecera", {tituloWeb: "Panel de Pesaje"}) %>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="fw-bold"><i class="fas fa-balance-scale"></i> Estación de Pesaje y Medición</h2>
    </div>
    <% if (eventoActual) { %>
        <p class="text-muted mb-0">Evento: <strong><%= eventoActual.nombre %></strong></p>
    <% } else { %>
        <div class="alert alert-warning mt-2">
            <i class="fas fa-exclamation-triangle me-1"></i> No se especificó un evento en la URL (<code>?evento=ID</code>) — no se podrá guardar ningún pesaje sin saber para cuál evento es.
        </div>
    <% } %>

    <!-- Buscador Rápido -->
    <div class="row my-4">
        <div class="col-md-6">
            <input type="text" id="buscarAtleta" class="form-control form-control-lg shadow-sm" placeholder="Buscar por Nombre, Cédula o ID-FDFF...">
        </div>
    </div>

    <!-- Tabla de Atletas -->
    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover bg-white align-middle" id="tablaAtletas">
            <thead class="table-dark">
                <tr>
                    <th class="h-20" style="width: 10%;">ID-FDFF</th>
                    <th class="h-20" style="width: 25%;">Nombre</th>
                    <th class="h-20" style="width: 15%;">Cédula</th>
                    <th class="text-center h-20" style="width: 15%;">Afiliación</th>
                    <th class="text-center h-20" style="width: 15%;">Peso / Estatura</th>
                    <th class="h-20" style="width: 20%;">Acción</th>
                </tr>
            </thead>
            <tbody>
    <% atletas.forEach(atleta => {
        const esInactivo = (atleta.estatus_afiliacion === 'deshabilitado' || atleta.estatus_afiliacion === 'pendiente');
        const yaPesado = !!(eventoActual && atleta.pesaje_evento_id === eventoActual.id);
    %>
    <tr class="<%= esInactivo ? 'table-danger' : '' %>" data-atleta-id="<%= atleta.id %>">
        <td><strong><%= atleta.idfdff || '---' %></strong></td>
        <td>
            <%= atleta.nombre %>
            <% if(esInactivo) { %><br><small class="text-danger fw-bold"><i class="fas fa-lock"></i> REQUIERE VALIDACIÓN/PAGO</small><% } %>
        </td>
        <td><%= atleta.cedula %></td>
        <td class="text-center">
            <span class="badge <%= atleta.estatus_afiliacion === 'habilitado' ? 'bg-success' : 'bg-secondary' %>">
                <%= atleta.estatus_afiliacion.toUpperCase() %>
            </span>
        </td>
        <td class="text-center small">
            <% if (yaPesado) { %>
                <span class="fw-bold"><%= atleta.peso %> kg</span> / <span class="fw-bold"><%= atleta.estatura %> cm</span>
                <br><span class="badge bg-info-subtle text-info-emphasis">Pesado para este evento</span>
            <% } else { %>
                <span class="text-muted">Sin confirmar</span>
            <% } %>
        </td>
        <td>
            <div class="btn-group">
                <!-- PESAR: solo si aun no se ha confirmado peso/estatura para ESTE evento -->
                <button class="btn btn-primary btn-sm fw-bold"
                        onclick="abrirModalPesaje('<%= atleta.id %>', '<%= atleta.nombre %>', null, null)"
                        <%= (esInactivo || yaPesado || !eventoActual) ? 'disabled' : '' %>>
                    PESAR
                </button>
                <!-- EDITAR: solo si ya se peso para este evento (permite corregir un error) -->
                <button class="btn btn-outline-primary btn-sm fw-bold"
                        onclick="abrirModalPesaje('<%= atleta.id %>', '<%= atleta.nombre %>', <%= atleta.peso || 'null' %>, <%= atleta.estatura || 'null' %>)"
                        <%= (esInactivo || !yaPesado || !eventoActual) ? 'disabled' : '' %>>
                    <i class="fas fa-edit"></i> EDITAR
                </button>
            </div>
        </td>
    </tr>
    <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- VENTANA FLOTANTE (MODAL) -->
<div class="modal fade" id="modalPesaje" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Medición: <span id="nombreAtletaModal"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
           <form id="formGuardarPesaje">
                <div class="modal-body p-4">
                    <input type="hidden" id="atletaIdInput">
                    <input type="hidden" id="eventoIdInput" value="<%= eventoActual ? eventoActual.id : '' %>">

                    <div class="text-center mb-3">
                        <span class="badge bg-secondary">Juez de Turno: <%= juezLogueado ? juezLogueado.nombre : 'No identificado' %></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="form-label fw-bold">Peso (kg)</label>
                            <input type="number" step="0.01" id="pesoActual" class="form-control form-control-lg text-center" required>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold">Estatura (cm)</label>
                            <input type="number" step="0.1" id="estaturaActual" class="form-control form-control-lg text-center" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold">GUARDAR</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="/js/supabase.js"></script>
<script>
    const _supabase = supabase.createClient("<%= SUPABASE_URL %>", "<%= SUPABASE_ANON_KEY %>");
    const modalElement = document.getElementById('modalPesaje');
    const myModal = new bootstrap.Modal(modalElement);

    // --- FUNCIÓN DEL SWITCH (AFILIACIÓN) ---
    async function actualizarAfiliacion(atletaId, estaActivo) {
        if (!atletaId || atletaId === "") {
            console.error("Error: ID de atleta no detectado");
            return;
        }

        const nuevoEstatus = estaActivo ? 'habilitado' : 'deshabilitado';
        const fechaHoy = estaActivo ? new Date().toISOString().split('T')[0] : null;

        const { error: errAtleta } = await _supabase
            .from('atletas')
            .update({
                estatus_afiliacion: nuevoEstatus,
                fecha_ultima_renovacion: fechaHoy
            })
            .eq('id', atletaId);

        if (errAtleta) {
            alert("Error al actualizar estatus: " + errAtleta.message);
            console.log("Detalles del error:", errAtleta);
            return;
        }

        if (estaActivo) {
            await _supabase
                .from('profiles')
                .update({ role: 'atleta' })
                .eq('id', atletaId);
        }

        alert("Atleta " + (estaActivo ? 'Habilitado' : 'Deshabilitado') + " correctamente.");
        window.location.reload();
    }

    function abrirModalPesaje(id, nombre, pesoActual, estaturaActual) {
        document.getElementById('atletaIdInput').value = id;
        document.getElementById('nombreAtletaModal').innerText = nombre;
        document.getElementById('pesoActual').value = pesoActual != null ? pesoActual : '';
        document.getElementById('estaturaActual').value = estaturaActual != null ? estaturaActual : '';
        myModal.show();
    }

    document.getElementById('buscarAtleta').addEventListener('keyup', function() {
        let valor = normalizarBusquedaFDFF(this.value);
        let filas = document.querySelectorAll('#tablaAtletas tbody tr');
        filas.forEach(fila => {
            fila.style.display = normalizarBusquedaFDFF(fila.innerText).includes(valor) ? '' : 'none';
        });
    });

    document.getElementById('formGuardarPesaje').addEventListener('submit', async (e) => {
        e.preventDefault();
        const eventoId = document.getElementById('eventoIdInput').value;
        if (!eventoId) {
            return alert('No hay un evento seleccionado (falta ?evento=ID en la URL). No se puede guardar.');
        }

        const payload = {
            atletaId: document.getElementById('atletaIdInput').value,
            eventoId,
            peso: parseFloat(document.getElementById('pesoActual').value),
            estatura: parseFloat(document.getElementById('estaturaActual').value)
        };

        try {
            const resp = await fetch('/inscripcion/pesaje/guardar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const resultado = await resp.json();
            if (resultado.estado) {
                window.location.reload();
            } else {
                alert('Error al guardar: ' + resultado.mensaje);
            }
        } catch (err) {
            alert('Error de conexión con el servidor.');
        }
    });
</script>

<%- include("../template/footer") %>
