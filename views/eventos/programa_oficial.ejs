<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= resumido ? 'Programa Resumido' : 'Programa Oficial' %> — <%= evento.nombre %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: Arial, sans-serif; font-size: 10pt; color: #111; background: #fff; }

        .controles {
            background: #1a1a2e; color: #fff; padding: 12px 20px;
            display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
        }
        .controles h5 { flex: 1; margin: 0; font-size: 13pt; }
        .controles button { padding: 7px 18px; border: none; border-radius: 5px; font-size: 10pt; cursor: pointer; font-weight: bold; }
        .btn-imprimir { background: #28a745; color: #fff; }
        .btn-cerrar   { background: #6c757d; color: #fff; }
        @media print { .controles { display: none !important; } }

        .documento { max-width: 900px; margin: 0 auto; padding: 14px 18px; }

        .cabecera { display: flex; align-items: center; border-bottom: 3px solid #c00; padding-bottom: 10px; margin-bottom: 10px; }
        .cabecera img { width: 72px; height: auto; margin-right: 14px; }
        .cabecera-texto h2 { font-size: 14pt; color: #c00; font-weight: bold; text-transform: uppercase; }
        .cabecera-texto h3 { font-size: 11pt; margin: 2px 0; }
        .cabecera-texto p  { font-size: 9pt; color: #555; }

        .titulo-listado {
            text-align: center; margin: 10px 0 14px;
            border: 2px solid #111; padding: 8px 12px; background: #111; color: #fff;
        }
        .titulo-listado h4 { font-size: 14pt; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }
        .titulo-listado p  { font-size: 9.5pt; margin: 4px 0 0; color: #ccc; }

        .fila-programa {
            display: flex; align-items: center; gap: 10px;
            padding: 6px 10px; border-bottom: 1px solid #ddd;
        }
        .fila-programa:nth-child(even) { background: #f7f7f7; }
        .num-orden {
            min-width: 26px; text-align: center; font-weight: bold; font-size: 10.5pt;
            background: #111; color: #fff; border-radius: 3px; padding: 2px 4px;
        }
        .badge-tipo {
            font-size: 8pt; font-weight: bold; text-transform: uppercase; letter-spacing: .5px;
            padding: 3px 8px; border-radius: 3px; color: #fff; min-width: 82px; text-align: center;
        }
        .tipo-categoria   { background: #c00; }
        .tipo-protocolo   { background: #6c757d; }
        .tipo-premiacion  { background: #b8860b; }
        .tipo-receso      { background: #0d6efd; }
        .tipo-apertura    { background: #198754; }
        .tipo-actividad   { background: #333; }
        .nombre-bloque { flex: 1; font-weight: bold; font-size: 10pt; }
        .detalle-cat { font-size: 8.5pt; color: #555; font-weight: normal; }

        .tabla-atletas-cat { width: 100%; border-collapse: collapse; font-size: 8.5pt; margin: 2px 0 8px; }
        .tabla-atletas-cat th { background: #eee; text-align: left; padding: 3px 8px; }
        .tabla-atletas-cat td { padding: 2px 8px; border-bottom: 1px solid #eee; }
        .tabla-atletas-cat .col-dorsal { width: 40px; text-align: center; font-weight: bold; }

        .roster { margin: 4px 0 16px; border: 1px solid #ccc; border-radius: 4px; padding: 8px 12px; }
        .roster h5 { font-size: 9.5pt; text-transform: uppercase; color: #c00; margin-bottom: 6px; letter-spacing: .5px; }
        .roster-grupo { font-size: 9pt; margin-bottom: 4px; }
        .roster-grupo b { text-transform: uppercase; font-size: 7.5pt; color: #555; margin-right: 6px; }
        .chip-invitado { display: inline-block; background: #f2f2f2; border-radius: 3px; padding: 1px 6px; margin: 1px 3px 1px 0; }
        .chip-presidente { background: #c00; color: #fff; font-weight: bold; }

        .pie { text-align: center; font-size: 8pt; color: #888; margin-top: 18px; border-top: 1px solid #ddd; padding-top: 6px; }
    </style>
</head>
<body>

<div class="controles">
    <h5><%= resumido ? '📄 Programa Resumido' : '📋 Programa Oficial' %> del Evento — <%= evento.nombre %></h5>
    <button class="btn-imprimir" onclick="window.print()">🖨️ Imprimir</button>
    <button class="btn-cerrar" onclick="window.close()">✕ Cerrar</button>
</div>

<div class="documento">

    <div class="cabecera">
        <img src="/img/fdff3.jpg" alt="FDFF">
        <div class="cabecera-texto">
            <h2>Federación Dominicana de Fisiculturismo y Fitness</h2>
            <h3><%= evento.nombre %></h3>
            <p>
                <%= evento.lugar || '' %>
                <% if (evento.fecha_inicio) { %> &nbsp;|&nbsp; <%= new Date(evento.fecha_inicio).toLocaleDateString('es-DO', {year:'numeric',month:'long',day:'numeric'}) %> <% } %>
            </p>
        </div>
    </div>

    <div class="titulo-listado">
        <h4><%= resumido ? 'Programa Resumido' : 'Programa Oficial y Aprobado' %></h4>
        <p><%= resumido ? 'Estructura del evento sin listado de atletas — categorías, actividades e invitados' : 'Guion completo de tarima — categorías y actividades en orden de salida' %></p>
    </div>

    <% if ((juecesPanel && juecesPanel.length > 0) || (invitados && invitados.length > 0)) { %>
        <div class="roster">
            <h5>Mesa de Jueces e Invitados Especiales</h5>
            <% if (juecesPanel && juecesPanel.length > 0) { %>
                <div class="roster-grupo"><b>Jueces del Panel</b>
                    <% juecesPanel.forEach(j => { %>
                        <span class="chip-invitado <%= j.esPresidente ? 'chip-presidente' : '' %>"><%= j.nombre %><%= j.esPresidente ? ' — Presidente de Mesa' : '' %></span>
                    <% }) %>
                </div>
            <% } %>
            <%
            const _labelCat = { juez_no_panel: 'Jueces (fuera del panel)', staff: 'Staff', patrocinador: 'Patrocinadores', personalidad: 'Personalidades' };
            const _gruposInv = {};
            (invitados || []).forEach(inv => { (_gruposInv[inv.categoria] = _gruposInv[inv.categoria] || []).push(inv); });
            %>
            <% Object.keys(_gruposInv).forEach(cat => { %>
                <div class="roster-grupo"><b><%= _labelCat[cat] || cat %></b>
                    <% _gruposInv[cat].forEach(inv => { %>
                        <span class="chip-invitado"><%= inv.nombre %><%= inv.detalle ? ' — ' + inv.detalle : '' %></span>
                    <% }) %>
                </div>
            <% }) %>
        </div>
    <% } %>

    <% if (programa && programa.length > 0) { %>
        <% programa.forEach(bloque => { %>
            <% const claseTipo = {
                'Categoría': 'tipo-categoria', 'Protocolo': 'tipo-protocolo', 'Premiación': 'tipo-premiacion',
                'Receso': 'tipo-receso', 'Apertura': 'tipo-apertura'
            }[bloque.tipo] || 'tipo-actividad'; %>
            <div class="fila-programa">
                <span class="num-orden"><%= bloque.orden %></span>
                <span class="badge-tipo <%= claseTipo %>"><%= bloque.tipo %></span>
                <span class="nombre-bloque">
                    <%= bloque.nombre %>
                    <% if (bloque.tipo === 'Categoría' && bloque.totalAtletas) { %>
                        <span class="detalle-cat">— <%= bloque.totalAtletas %> atleta<%= bloque.totalAtletas === 1 ? '' : 's' %><% if (bloque.dorsalMin) { %>, dorsales <%= bloque.dorsalMin %>–<%= bloque.dorsalMax %><% } %></span>
                    <% } %>
                </span>
            </div>
            <% if (!resumido && bloque.tipo === 'Categoría' && bloque.atletas && bloque.atletas.length > 0) { %>
                <table class="tabla-atletas-cat">
                    <thead><tr><th class="col-dorsal">#</th><th>Atleta</th><th>Ciudad</th><th>Team</th></tr></thead>
                    <tbody>
                        <% bloque.atletas.forEach(a => { %>
                            <tr>
                                <td class="col-dorsal"><%= a.dorsal || '—' %></td>
                                <td><%= a.nombre %></td>
                                <td><%= a.ciudad %></td>
                                <td><%= a.team %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        <% }) %>
    <% } else { %>
        <div style="text-align:center; padding: 40px; color:#888;">
            El programa oficial aún no ha sido generado. Debe oficializar la preparación del evento primero.
        </div>
    <% } %>

    <div class="pie">
        Federación Dominicana de Fisiculturismo y Fitness (FDFF) — Documento oficial &nbsp;|&nbsp;
        Generado el <%= new Date().toLocaleDateString('es-DO', {year:'numeric',month:'long',day:'numeric'}) %>
    </div>
</div>

</body>
</html>
