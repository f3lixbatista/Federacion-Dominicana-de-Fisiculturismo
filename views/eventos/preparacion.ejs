<%- include("../template/cabecera", {tituloWeb: "Preparación de Evento"}) %>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-dark"><i class="fas fa-cogs text-primary"></i> Preparación de Evento</h1>
            <p class="text-muted mb-0">Gestione el cuórum, fusiones y defina el Orden de Salida oficial.</p>
        </div>
        <a href="/eventos/<%= eventoId %>" class="btn btn-outline-secondary fw-bold">
            <i class="fas fa-arrow-left"></i> Volver al Panel
        </a>
    </div>

    <!-- FORMULARIO MAESTRO DE LOGÍSTICA -->
    <form id="formOficializarEvento">
        <input type="hidden" id="idEvento" value="<%= eventoId %>">

        <!-- PANEL: AGREGAR ACTIVIDAD AL PROGRAMA -->
        <div class="card p-4 shadow-sm mb-4 border-2 border-warning">
            <h4 class="fw-bold text-dark mb-1"><i class="fas fa-calendar-plus text-warning"></i> Agregar Actividad al Programa</h4>
            <p class="text-muted small mb-3">Intercale premiaciones, recesos y otros bloques entre las categorías — se agregan al final del programa y luego se arrastran (⣿) o se les escribe el número de orden deseado.</p>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">Tipo de Actividad</label>
                    <select id="selectTipoActividad" class="form-select form-select-sm border-warning fw-bold">
                        <option value="premiacion">🏆 Premiación</option>
                        <option value="receso">⏱️ Receso</option>
                        <option value="protocolo">🎙️ Protocolo</option>
                        <option value="apertura">🎊 Apertura / Cierre</option>
                        <option value="otro">📋 Otra actividad</option>
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label small fw-bold">Descripción</label>
                    <input type="text" id="inputDescActividad" class="form-control form-control-sm"
                           placeholder="Ej: Premiación bloque femenino, Receso 15 min..." maxlength="120">
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-warning fw-bold w-100 btn-sm" onclick="agregarActividadAlPrograma()">
                        <i class="fas fa-plus me-1"></i> Agregar
                    </button>
                </div>
            </div>
            <div class="mt-2">
                <button type="button" class="btn btn-outline-secondary btn-sm me-1" onclick="quickActividad('premiacion','Ceremonia de Premiación')">🏆 Premiación rápida</button>
                <button type="button" class="btn btn-outline-info btn-sm me-1" onclick="quickActividad('receso','Receso de 15 minutos')">⏱️ Receso</button>
                <button type="button" class="btn btn-outline-dark btn-sm me-1" onclick="quickActividad('protocolo','Oración de Inicio')">🎙️ Oración</button>
                <button type="button" class="btn btn-outline-dark btn-sm me-1" onclick="quickActividad('protocolo','Himno Nacional')">🎙️ Himno</button>
                <button type="button" class="btn btn-outline-success btn-sm" onclick="quickActividad('apertura','Palabras de Apertura')">🎊 Apertura</button>
            </div>
        </div>

        <!-- Vista de Configuración: "El Armado del Panel" -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white fw-bold d-flex justify-content-between align-items-center">
                <span><i class="fas fa-th me-2"></i> Configuración de Panel de Jueces</span>
                <% if (panelActual) { %>
                    <span class="badge bg-warning text-dark">Panel N° 1 — <%= panelActual.cantidad_jueces %> jueces</span>
                <% } %>
            </div>
            <div class="card-body">
                <% if (!panelActual) { %>
                    <p class="text-muted small">Aún no se ha creado el panel principal de este evento. Elija cuántos jueces tendrá la mesa — el juez de la silla central quedará marcado automáticamente como Presidente de Mesa.</p>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label class="form-label small fw-bold">Cantidad de Jueces en Mesa</label>
                            <select id="selectCantidadJueces" class="form-select">
                                <option value="3">3 Jueces</option>
                                <option value="5">5 Jueces (Mínimo Oficial)</option>
                                <option value="7" selected>7 Jueces (Campeonatos Nacionales)</option>
                                <option value="9">9 Jueces (Copas Internacionales)</option>
                                <option value="11">11 Jueces</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-warning fw-bold w-100" onclick="crearPanelUno()">
                                <i class="fas fa-plus me-1"></i> Crear Panel
                            </button>
                        </div>
                    </div>
                <% } else {
                    const _centro = Math.ceil(panelActual.cantidad_jueces / 2);
                %>
                    <div class="row text-center mb-4">
                        <% for(let i=1; i<=panelActual.cantidad_jueces; i++) { const esCentro = (i === _centro); %>
                            <div class="col">
                                <div class="p-3 border rounded <%= esCentro ? 'bg-warning bg-opacity-25 border-warning border-2' : 'bg-light' %>">
                                    <label class="small fw-bold">SILLA <%= i %></label>
                                    <select class="form-select select-juez" data-silla="<%= i %>" data-es-centro="<%= esCentro %>">
                                        <option value="">-- Vacío --</option>
                                        <% juecesDisponibles.forEach(juez => { %>
                                            <option value="<%= juez.id %>" <%= sillasPanel[i] === juez.id ? 'selected' : '' %>><%= juez.nombre %></option>
                                        <% }) %>
                                    </select>
                                    <div class="mt-2 small fw-bold <%= esCentro ? 'text-warning' : 'text-muted' %>" style="min-height: 1.2em;">
                                        <% if (esCentro) { %><i class="fas fa-crown"></i> Presidente de Mesa<% } %>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                    <button type="button" onclick="guardarPanel()" class="btn btn-primary fw-bold w-100">
                        <i class="fas fa-save me-2"></i> GUARDAR PANEL Y POSICIONES
                    </button>
                <% } %>
            </div>
        </div>

        <!-- PANEL: INVITADOS ESPECIALES PARA MENCIÓN DEL MC -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="fas fa-user-tie me-2"></i> Invitados Especiales (Apertura — Mención del MC)
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">Jueces que no están en el panel principal, staff, patrocinadores y personalidades a mencionar en la apertura. Los jueces del panel principal no se agregan aquí — se toman automáticamente.</p>
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Categoría</label>
                        <select id="selectCategoriaInvitado" class="form-select form-select-sm">
                            <option value="juez_no_panel">Juez (fuera del panel)</option>
                            <option value="staff">Staff</option>
                            <option value="patrocinador">Patrocinador</option>
                            <option value="personalidad">Personalidad</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">Nombre</label>
                        <input type="text" id="inputNombreInvitado" class="form-control form-control-sm" maxlength="120">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">Detalle / Cargo</label>
                        <input type="text" id="inputDetalleInvitado" class="form-control form-control-sm" placeholder="Ej: Presidente FDFF, Gimnasio X..." maxlength="120">
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-warning fw-bold w-100 btn-sm" onclick="agregarInvitado()">
                            <i class="fas fa-plus me-1"></i> Agregar
                        </button>
                    </div>
                </div>
                <div id="listaInvitados" class="list-group">
                    <% (invitados || []).forEach(inv => { %>
                        <div class="list-group-item d-flex justify-content-between align-items-center invitado-item" data-id="<%= inv.id %>">
                            <div>
                                <span class="badge bg-secondary text-uppercase me-2" style="font-size:.65rem;"><%= inv.categoria.replace('_', ' ') %></span>
                                <strong><%= inv.nombre %></strong>
                                <% if (inv.detalle) { %><span class="text-muted small"> — <%= inv.detalle %></span><% } %>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarInvitado(this, '<%= inv.id %>')">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <%
        // Unificar categorías y actividades en una sola lista ordenada
        const _todosItems = [
            ...(arrayCategorias || []).map((c, i) => ({
                _tipo: 'categoria',
                _orden: c.orden_secuencia_categoria || (i + 1),
                _data: c
            })),
            ...(actividades || []).map(a => ({
                _tipo: 'actividad',
                _orden: a.orden_secuencia || 0,
                _data: a
            }))
        ].sort((a, b) => a._orden - b._orden);
        const _tipoMeta = {
            premiacion: { icon: 'fa-trophy',     cls: 'warning',   emoji: '🏆', label: 'Premiación'  },
            receso:     { icon: 'fa-clock',      cls: 'info',      emoji: '⏱️', label: 'Receso'      },
            protocolo:  { icon: 'fa-microphone', cls: 'secondary', emoji: '🎙️', label: 'Protocolo'   },
            apertura:   { icon: 'fa-star',       cls: 'success',   emoji: '🎊', label: 'Apertura'    },
            otro:       { icon: 'fa-list',       cls: 'dark',      emoji: '📋', label: 'Actividad'   }
        };
        let _catIdx = 0;
        %>

        <div id="listaPrograma">
        <% _todosItems.forEach(item => { %>

            <% if (item._tipo === 'categoria') { const catRel = item._data; _catIdx++; %>
            <div class="card mb-3 shadow-sm border-2 cat-container-box programa-item" id="card-<%= catRel.id %>"
                 data-modalidad="<%= catRel.categorias?.modalidad || 'N/A' %>"
                 data-sexo="<%= catRel.categorias?.sexo || 'N/A' %>"
                 data-disciplina="<%= catRel.categorias?.disciplina || 'N/A' %>"
                 data-division="<%= catRel.categorias?.division || 'N/A' %>">

                <div class="card-header bg-light p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fas fa-grip-vertical text-muted drag-handle" draggable="true" title="Arrastrar para reordenar" style="cursor:grab;"></i>
                        <label class="fw-bold text-secondary small">ORDEN:</label>
                        <input type="number" name="orden_salida" value="<%= catRel.orden_secuencia_categoria || _catIdx %>"
                               class="form-control form-control-sm text-center fw-bold border-primary input-orden" style="width: 70px;" required min="1">
                        <h5 class="mb-0 ms-3 fw-bold text-dark"><%= catRel.categorias.nombre %></h5>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="badge bg-secondary px-2 py-1">Atletas: <%= catRel.total_atletas %></span>
                        <input type="hidden" name="evento_cat_id" value="<%= catRel.id %>">
                        <select name="estatus_categoria" class="form-select form-select-sm fw-bold border-secondary select-estatus-cat"
                                onchange="evaluarEstadoCategoria('<%= catRel.id %>', this.value)">
                            <option value="abierta activa" <%= catRel.estatus_logistica === 'abierta activa' ? 'selected' : '' %>>Abierta Activa</option>
                            <option value="fusionada" <%= catRel.estatus_logistica === 'fusionada' ? 'selected' : '' %>>Fusionar</option>
                            <option value="abierta exhibicion" <%= catRel.estatus_logistica === 'abierta exhibicion' ? 'selected' : '' %>>Abierta Exhibición</option>
                            <option value="exhibicion" <%= catRel.estatus_logistica === 'exhibicion' ? 'selected' : '' %>>Exhibición</option>
                            <option value="cerrada" <%= catRel.estatus_logistica === 'cerrada' ? 'selected' : '' %>>Cerrada / Cancelada</option>
                        </select>
                    </div>
                </div>
                <div class="card-body p-0 container-tabla-atletas">
                    <table class="table table-sm table-hover mb-0 text-center align-middle">
                        <thead class="table-light small text-secondary">
                            <tr>
                                <th class="text-start ps-4">Atleta</th>
                                <th>Cédula</th>
                                <th>Team / Coach</th>
                                <th>Mediciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(catRel.atletas && catRel.atletas.length > 0) { %>
                                <% catRel.atletas.forEach(atleta => { %>
                                    <tr>
                                        <td class="text-start ps-4 fw-bold"><%= atleta.nombre %></td>
                                        <td><%= atleta.cedula %></td>
                                        <td><%= atleta.gimnasio || '--' %></td>
                                        <td class="small text-muted">P: <%= atleta.peso %>kg | E: <%= atleta.estatura %>cm</td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr><td colspan="4" class="text-center py-3 text-muted fst-italic">Sin atletas oficializados en esta categoría</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <% } else { const act = item._data; const meta = _tipoMeta[act.tipo] || _tipoMeta['otro']; %>
            <div class="card mb-3 shadow-sm border-2 border-<%= meta.cls %> actividad-card programa-item"
                 data-actividad-id="<%= act.id %>" data-tipo="<%= act.tipo %>">
                <div class="card-header bg-<%= meta.cls %> bg-opacity-10 p-3 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <i class="fas fa-grip-vertical text-muted drag-handle" draggable="true" title="Arrastrar para reordenar" style="cursor:grab;"></i>
                        <label class="fw-bold text-secondary small">ORDEN:</label>
                        <input type="number" class="form-control form-control-sm text-center fw-bold border-<%= meta.cls %> input-orden-act"
                               style="width: 70px;" value="<%= act.orden_secuencia %>" min="1">
                        <span class="badge bg-<%= meta.cls %> <%= meta.cls === 'warning' || meta.cls === 'info' ? 'text-dark' : '' %> px-2">
                            <%= meta.emoji %> <%= meta.label %>
                        </span>
                        <input type="text" class="form-control form-control-sm input-desc-act"
                               style="max-width: 380px;" value="<%= act.descripcion %>" placeholder="Descripción de la actividad">
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarActividadCard(this)">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                </div>
            </div>
            <% } %>

        <% }) %>
        </div>
        <!-- #listaPrograma: contenedor único y reordenable (categorías + actividades) -->

        <!-- BOTÓN DE CIERRE -->
        <div class="card p-4 border-primary bg-light shadow-sm text-center mb-5">
            <h4 class="fw-bold text-primary mb-2"><i class="fas fa-lock"></i> Sello y Cierre de Logística</h4>
            <p class="text-muted small">Al presionar el botón se reordenará el evento, se ejecutarán las fusiones y el sistema asignará el <b>Dorsal Automático Correlativo</b> a los atletas aptos.</p>
            <button type="button" onclick="procesarOficializacion()" class="btn btn-primary btn-lg fw-bold px-5 py-3 shadow">
                OFICIALIZAR LISTADOS Y GENERAR DORSALES
            </button>
        </div>
    </form>
</div>

<!-- MODAL FLOTANTE: FUSIÓN DE CATEGORÍAS AFINES -->
<div class="modal fade" id="modalFusion" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0" style="border-radius: 15px;">
            <div class="modal-header bg-warning text-dark py-3">
                <h5 class="modal-title fw-bold"><i class="fas fa-random me-2"></i> Fusionar Categoría</h5>
                <button type="button" class="btn-close" onclick="cancelarFusion()"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small">Selecciona la categoría destino. El sistema solo muestra categorías que comparten **Modalidad, Sexo, Disciplina y División** reglamentaria.</p>
                <input type="hidden" id="idCatOrigen">
                <div class="mb-3">
                    <label class="form-label fw-bold small text-secondary">Categorías Destino Compatibles:</label>
                    <select id="selectCatDestino" class="form-select form-select-lg border-warning">
                        <!-- Se llena dinámicamente -->
                    </select>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm fw-bold" onclick="cancelarFusion()">Cancelar</button>
                <button type="button" class="btn btn-warning btn-sm fw-bold" onclick="confirmarFusion()">APLICAR FUSIÓN</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/supabase.js"></script>
<script>
    window._supabase = supabase.createClient("<%= SUPABASE_URL %>", "<%= SUPABASE_ANON_KEY %>");

    // Guardamos en memoria el estado real de fusiones ejecutadas en la interfaz
    let mapaFusiones = {}; 
    const modalFusionObj = new bootstrap.Modal(document.getElementById('modalFusion'));

    function evaluarEstadoCategoria(catRelId, valor) {
        if (valor === 'fusionada') {
            document.getElementById('idCatOrigen').value = catRelId;
            const origenCard = document.getElementById(`card-${catRelId}`);
            
            // Extraer metadatos del contenedor HTML para cumplir la regla estricta de la FDFF
            const mod = origenCard.dataset.modalidad;
            const sex = origenCard.dataset.sexo;
            const disc = origenCard.dataset.disciplina;
            const div = origenCard.dataset.division;

            const selectDestino = document.getElementById('selectCatDestino');
            selectDestino.innerHTML = '<option value="" disabled selected>Seleccione destino...</option>';

            // Filtrar en tiempo real buscando coincidencias afines exactas
            const todasLasCards = document.querySelectorAll('.cat-container-box');
            let encontradas = 0;

            todasLasCards.forEach(card => {
                const id = card.id.replace('card-', '');
                if (id !== catRelId && 
                    card.dataset.modalidad === mod && 
                    card.dataset.sexo === sex && 
                    card.dataset.disciplina === disc && 
                    card.dataset.division === div) {
                    
                    const nombre = card.querySelector('h5').innerText;
                    selectDestino.innerHTML += `<option value="${id}">${nombre}</option>`;
                    encontradas++;
                }
            });

            if (encontradas === 0) {
                alert("No existen categorías compatibles en el evento para ejecutar esta fusión reglamentaria.");
                document.getElementById(`card-${catRelId}`).querySelector('.select-estatus-cat').value = 'abierta activa';
                return;
            }

            modalFusionObj.show();
        } else {
            // Si cambian a otro estado, limpiamos cualquier rastro de fusión previa
            delete mapaFusiones[catRelId];
            document.getElementById(`card-${catRelId}`).style.border = 'initial';
        }
    }

    function confirmarFusion() {
        const origen = document.getElementById('idCatOrigen').value;
        const destino = document.getElementById('selectCatDestino').value;

        if (!destino) return alert("Debe seleccionar una categoría destino.");

        mapaFusiones[origen] = destino;
        
        // Marcaje visual de la interfaz
        const cardOrigen = document.getElementById(`card-${origen}`);
        cardOrigen.style.border = '2px dashed #ffc107';
        
        modalFusionObj.hide();
    }

    function cancelarFusion() {
        const origen = document.getElementById('idCatOrigen').value;
        document.getElementById(`card-${origen}`).querySelector('.select-estatus-cat').value = 'abierta activa';
        modalFusionObj.hide();
    }

    const _TIPO_META = {
        premiacion: { cls: 'warning',   emoji: '🏆', label: 'Premiación'  },
        receso:     { cls: 'info',      emoji: '⏱️', label: 'Receso'      },
        protocolo:  { cls: 'secondary', emoji: '🎙️', label: 'Protocolo'   },
        apertura:   { cls: 'success',   emoji: '🎊', label: 'Apertura'    },
        otro:       { cls: 'dark',      emoji: '📋', label: 'Actividad'   }
    };

    function agregarActividadAlPrograma() {
        const tipo  = document.getElementById('selectTipoActividad').value;
        const desc  = document.getElementById('inputDescActividad').value.trim();
        if (!desc) return alert('Escriba una descripción para la actividad.');
        _crearCardActividad(tipo, desc, null, null);
        document.getElementById('inputDescActividad').value = '';
    }

    function quickActividad(tipo, desc) {
        document.getElementById('selectTipoActividad').value = tipo;
        document.getElementById('inputDescActividad').value  = desc;
        document.getElementById('inputDescActividad').focus();
    }

    function _crearCardActividad(tipo, desc, orden, actividadId) {
        const meta    = _TIPO_META[tipo] || _TIPO_META['otro'];
        const txtBadge = (meta.cls === 'warning' || meta.cls === 'info') ? 'text-dark' : '';
        const card = document.createElement('div');
        card.className = `card mb-3 shadow-sm border-2 border-${meta.cls} actividad-card programa-item`;
        card.dataset.actividadId = actividadId || '';
        card.dataset.tipo = tipo;
        card.innerHTML = `
            <div class="card-header bg-${meta.cls} bg-opacity-10 p-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <i class="fas fa-grip-vertical text-muted drag-handle" draggable="true" title="Arrastrar para reordenar" style="cursor:grab;"></i>
                    <label class="fw-bold text-secondary small">ORDEN:</label>
                    <input type="number" class="form-control form-control-sm text-center fw-bold border-${meta.cls} input-orden-act"
                           style="width:70px;" value="${orden || 0}" min="1">
                    <span class="badge bg-${meta.cls} ${txtBadge} px-2">${meta.emoji} ${meta.label}</span>
                    <input type="text" class="form-control form-control-sm input-desc-act"
                           style="max-width:380px;" value="${desc}" placeholder="Descripción de la actividad">
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarActividadCard(this)">
                    <i class="fas fa-trash-alt"></i>
                </button>
            </div>`;
        document.getElementById('listaPrograma').appendChild(card);
        renumerarPrograma();
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function eliminarActividadCard(btn) {
        if (!confirm('¿Eliminar esta actividad del programa?')) return;
        btn.closest('.actividad-card').remove();
        renumerarPrograma();
    }

    // ── Reordenamiento por posición: arrastrar o escribir un número mueve la tarjeta ──
    // El número de orden siempre se deriva de la posición en la lista, nunca se asigna
    // suelto — por eso no pueden existir duplicados una vez armada la lista.
    function _itemsPrograma() {
        return Array.from(document.querySelectorAll('#listaPrograma > .programa-item'));
    }

    function renumerarPrograma() {
        _itemsPrograma().forEach((item, i) => {
            const input = item.querySelector('.input-orden, .input-orden-act');
            if (input) input.value = i + 1;
        });
    }

    let _draggedItem = null;

    function _onDragStart(e) {
        const handle = e.target.closest('.drag-handle');
        if (!handle) { e.preventDefault(); return; }
        _draggedItem = handle.closest('.programa-item');
        e.dataTransfer.effectAllowed = 'move';
    }

    function _onDragOver(e) {
        const target = e.target.closest('.programa-item');
        if (!target || !_draggedItem || target === _draggedItem) return;
        e.preventDefault();
        const rect = target.getBoundingClientRect();
        const despuesDelMedio = (e.clientY - rect.top) > rect.height / 2;
        target.parentNode.insertBefore(_draggedItem, despuesDelMedio ? target.nextSibling : target);
        renumerarPrograma();
    }

    function _onDragEnd() {
        _draggedItem = null;
        renumerarPrograma();
    }

    function _onCambioOrden(e) {
        const input = e.target;
        if (!input.matches('.input-orden, .input-orden-act')) return;
        const item = input.closest('.programa-item');
        const items = _itemsPrograma();
        const total = items.length;
        let destino = parseInt(input.value) || total;
        destino = Math.min(Math.max(destino, 1), total);

        const resto = items.filter(i => i !== item);
        resto.splice(destino - 1, 0, item);

        const contenedor = document.getElementById('listaPrograma');
        resto.forEach(i => contenedor.appendChild(i));
        renumerarPrograma();
        item.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    const _listaPrograma = document.getElementById('listaPrograma');
    _listaPrograma.addEventListener('dragstart', _onDragStart);
    _listaPrograma.addEventListener('dragover', _onDragOver);
    _listaPrograma.addEventListener('drop', e => e.preventDefault());
    _listaPrograma.addEventListener('dragend', _onDragEnd);
    _listaPrograma.addEventListener('change', _onCambioOrden);
    renumerarPrograma(); // normaliza a 1..N según el orden visual real, por si la BD trae huecos o duplicados de antes

    async function procesarOficializacion() {
        if (!confirm("¿Confirma cerrar la fase logística? Esto recalculará listados y asignará números correlativos.")) return;

        const idEvento = document.getElementById('idEvento').value;

        // Categorías
        const dataLogistica = [];
        document.querySelectorAll('.cat-container-box').forEach(b => {
            const id = b.id.replace('card-', '');
            dataLogistica.push({
                evento_cat_id: id,
                nombre: b.querySelector('h5')?.innerText.trim() || '',
                orden: parseInt(b.querySelector('.input-orden').value) || 0,
                estatus: b.querySelector('.select-estatus-cat').value,
                fusion_destino_id: mapaFusiones[id] || null
            });
        });

        // Actividades (existentes en DOM + nuevas)
        const dataActividades = [];
        document.querySelectorAll('.actividad-card').forEach(card => {
            dataActividades.push({
                tipo: card.dataset.tipo || 'otro',
                descripcion: card.querySelector('.input-desc-act')?.value || '',
                orden: parseInt(card.querySelector('.input-orden-act')?.value) || 0
            });
        });

        try {
            const res = await fetch('/eventos/preparacion/oficializar', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ eventoId: idEvento, logistica: dataLogistica, actividades: dataActividades })
            });

            const result = await res.json();
            if (result.estado) {
                alert("¡Fase completada! Dorsales generados y listados publicados en cartelera web.");
                window.location.href = `/eventos/${idEvento}`;
            } else {
                alert("Error: " + result.mensaje);
            }
        } catch (e) {
            alert("Error de conexión con el servidor backend.");
        }
    }

    async function crearPanelUno() {
        const cant = parseInt(document.getElementById('selectCantidadJueces').value);
        const idEvento = document.getElementById('idEvento').value;

        const { error } = await _supabase.from('paneles_jueces').insert({
            id_evento: idEvento,
            numero_panel: 1,
            cantidad_jueces: cant
        });

        if (error) return alert('Error creando el panel: ' + error.message);
        location.reload();
    }

    async function guardarPanel() {
        const panelId = "<%= panelActual ? panelActual.id : '' %>";
        if (!panelId) return alert('Primero cree el panel.');

        const filas = [];
        document.querySelectorAll('.select-juez').forEach(select => {
            const juezId = select.value;
            if (!juezId) return;
            filas.push({
                panel_id: panelId,
                juez_id: juezId,
                numero_silla: parseInt(select.dataset.silla),
                es_presidente: select.dataset.esCentro === 'true'
            });
        });

        if (filas.length === 0) return alert('Asigne al menos un juez antes de guardar.');

        // Reemplazo total del panel para que quede limpio (mismo patrón que el modal de Centro de Mando)
        await _supabase.from('panel_sillas_jueces').delete().eq('panel_id', panelId);
        const { error } = await _supabase.from('panel_sillas_jueces').insert(filas);

        if (!error) {
            alert("Panel de Jueces configurado con éxito. La silla central quedó asignada como Presidente de Mesa.");
        } else {
            alert("Error al configurar el panel: " + error.message);
        }
    }

    async function agregarInvitado() {
        const idEvento = document.getElementById('idEvento').value;
        const categoria = document.getElementById('selectCategoriaInvitado').value;
        const nombre = document.getElementById('inputNombreInvitado').value.trim();
        const detalle = document.getElementById('inputDetalleInvitado').value.trim();
        if (!nombre) return alert('Escriba un nombre.');

        const { data, error } = await _supabase.from('programa_invitados')
            .insert({ evento_id: idEvento, categoria, nombre, detalle })
            .select('id, categoria, nombre, detalle')
            .single();

        if (error) return alert('Error agregando invitado: ' + error.message);

        const row = document.createElement('div');
        row.className = 'list-group-item d-flex justify-content-between align-items-center invitado-item';
        row.dataset.id = data.id;
        row.innerHTML = `
            <div>
                <span class="badge bg-secondary text-uppercase me-2" style="font-size:.65rem;">${data.categoria.replace('_', ' ')}</span>
                <strong>${data.nombre}</strong>
                ${data.detalle ? `<span class="text-muted small"> — ${data.detalle}</span>` : ''}
            </div>
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarInvitado(this, '${data.id}')">
                <i class="fas fa-trash-alt"></i>
            </button>`;
        document.getElementById('listaInvitados').appendChild(row);

        document.getElementById('inputNombreInvitado').value = '';
        document.getElementById('inputDetalleInvitado').value = '';
    }

    async function eliminarInvitado(btn, id) {
        if (!confirm('¿Eliminar este invitado?')) return;
        const { error } = await _supabase.from('programa_invitados').delete().eq('id', id);
        if (error) return alert('Error eliminando: ' + error.message);
        btn.closest('.invitado-item').remove();
    }
</script>

